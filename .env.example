# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Database (file path is created automatically)
DATABASE_PATH=./data/church.db

# CORS — comma separated origins, or * to allow everyone
CORS_ORIGINS=*

# If set, every non-GET request to /api/v1 requires this header: X-API-Key
# Leave empty to disable (fine for development).
API_KEY=

# Rate limiting (requests per window, per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Response cache for GET requests (seconds)
CACHE_TTL_SECONDS=30
CACHE_MAX_ENTRIES=500

# Set to false to silence per-request logs
REQUEST_LOG=true

# Number of reverse-proxy hops in front of the API (0 = none, 1 = nginx/azure)
TRUST_PROXY=1

# JSON body size limit
BODY_LIMIT=100kb

# Log level: debug | info | warn | error
LOG_LEVEL=info
